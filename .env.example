# FILE: /.env.example
# SplashWhats Configuration Example
# Copy this file to .env and update with your settings

# Database Configuration
DB_HOST=localhost
DB_DATABASE=splashwhats
DB_USERNAME=root
DB_PASSWORD=

# Application Configuration
APP_NAME=SplashWhats
APP_URL=http://localhost
APP_TIMEZONE=UTC

# Session Configuration
SESSION_LIFETIME=7200

# File Upload
MAX_UPLOAD_SIZE=5242880
ALLOWED_UPLOAD_TYPES=csv,jpg,jpeg,png

# Pagination
ITEMS_PER_PAGE=20

# Email Configuration (for notifications)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@splashwhats.com
MAIL_FROM_NAME=SplashWhats
